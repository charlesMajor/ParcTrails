{
  "name": "tp3",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "backend": "json-server-auth --watch ./backend/db-dev.json .js --delay 500 --routes ./backend/routes.json --host 127.0.0.1",
    "backend:seed": "node ./backend/seed/seed-db-with-fake-data.js",
    "backend:cypress": "json-server-auth --watch ./backend/cypress/db-cypress.json .js  --routes ./backend/routes.json --host 127.0.0.1",
    "backend:cypress:seed": "copy-files-from-to --config ./backend/cypress/copy-db-cypress.json"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.7",
    "@vue-leaflet/vue-leaflet": "^0.9.0",
    "axios": "^1.3.5",
    "bootstrap": "^5.2.3",
    "jwt-decode": "^3.1.2",
    "leaflet": "^1.9.3",
    "pinia": "^2.0.32",
    "vee-validate": "^4.8.4",
    "vue": "^3.2.47",
    "vue-router": "^4.1.6",
    "vue-toast-notification": "^3.1.1",
    "vue-loading-overlay": "^6.0.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^7.6.0",
    "@pinia/testing": "^0.0.16",
    "@testing-library/vue": "^7.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/test-utils": "^2.3.0",
    "bcryptjs": "^2.4.3",
    "copy-files-from-to": "^3.8.0",
    "cypress": "^12.7.0",
    "eslint": "^8.34.0",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^21.1.0",
    "json-server": "^0.17.3",
    "json-server-auth": "^2.1.0",
    "msw": "^1.2.1",
    "proj4": "^2.9.0",
    "start-server-and-test": "^2.0.0",
    "vite": "^4.1.4",
    "vitest": "^0.29.1"
  }
}
